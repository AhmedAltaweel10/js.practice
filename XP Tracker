xpTracker = { 
skills : {
CODE : {level: 1, xp: 0, xpToNext: 200},
FIT: {level: 1, xp: 0, xpToNext: 200},
INT: {level: 1, xp: 0, xpToNext: 200},
FIN: {level: 1, xp: 0, xpToNext: 200},
HEAL: {level: 1, xp: 0, xpToNext: 200},
EXPLORE: {level: 1, xp: 0, xpToNext: 200}, 
ADMIN: {level: 1, xp: 0, xpToNext: 200}, 
SOCIAL: {level: 1, xp: 0, xpToNext: 200}
},
addXP: function(skill, amount){
if (!this.skills[skill]) {
    return `Unknown skill: ${skill}`;} 
    if (typeof amount !== 'number' || amount <=0){
return 'Amount must be a positive number'}
const add = this.skills[skill]; 
add.xp += amount;
this.levelUp(skill)
},
levelUp: function(skillId){
while (this.skills[skillId].xp >= this.skills[skillId].xpToNext){ 
this.skills[skillId].xp -= this.skills[skillId].xpToNext;
this.skills[skillId].level += 1;
this.skills[skillId].xpToNext *= 1.02;}
},
status: function (){
    console.log(this.skills);
}
}
